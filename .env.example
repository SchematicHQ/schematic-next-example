# ---------------------------------------------------------------------------
# Copy this file to .env.local, then fill in the values below.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Schematic — from Settings > API Keys in https://app.schematichq.com
NEXT_PUBLIC_SCHEMATIC_PUBLISHABLE_KEY="api_"
SCHEMATIC_SECRET_KEY="sch_dev_"

# The component powering the /usage page, from the Components tab.
NEXT_PUBLIC_SCHEMATIC_COMPONENT_ID=""

# Clerk — from https://dashboard.clerk.com
# Not needed in demo mode; see below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_"
CLERK_SECRET_KEY="sk_test_"

# ---------------------------------------------------------------------------
# Demo mode (optional)
#
# Uncomment to skip Clerk entirely and identify as a single hardcoded
# company/user. Seed entitlements for the company key `id: "demo-co"` in your
# Schematic environment first, or every feature will read as unentitled.
# See src/utils/demoContext.ts.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_USER_KEY="demo-user"
# NEXT_PUBLIC_DEMO_COMPANY_NAME="Demo Company"
# NEXT_PUBLIC_DEMO_USER_NAME="Demo User"

# ---------------------------------------------------------------------------
# Local Schematic development only — leave unset to use the hosted API.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SCHEMATIC_API_URL="http://localhost:8080"
# NEXT_PUBLIC_SCHEMATIC_EVENT_URL="http://localhost:8081"
# NEXT_PUBLIC_SCHEMATIC_WEBSOCKET_URL="ws://localhost:8080"
